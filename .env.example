# ---------------------------------------------------------------------------
# Profile Match Engine — API keys
#
# Only fill in the providers you intend to use. The provider allowlist in
# app/settings.yaml decides which of these may be called for real profile
# data; see project.md section 20.
# ---------------------------------------------------------------------------

# Google Gemini            https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Groq                     https://console.groq.com/keys
GROQ_API_KEY=

# NVIDIA NIM               https://build.nvidia.com/
NVIDIA_NIM_API_KEY=

# OpenAI                   https://platform.openai.com/api-keys
OPENAI_API_KEY=

# ---------------------------------------------------------------------------
# Runtime
# ---------------------------------------------------------------------------
PME_DB_URL=sqlite:///storage/db/pme.sqlite
PME_STORAGE_DIR=storage
PME_LOG_LEVEL=INFO
